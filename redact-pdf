    "NL|NO|PL|PT|RO|SE|SI|SK|US|CA|AU|JP|CN|TR|RU"
)

PLACEHOLDER_RE = re.compile(r"\[[a-z_]+-\d+\]?")

DATE_SHAPE_RE = re.compile(
    r"\b(?:"
    r"\d{1,2}\.\d{1,2}\.\d{2,4}"
    r"|\d{4}-\d{2}-\d{2}"
    r"|\d{1,2}/\d{1,2}/\d{2,4}"
    r"|\d{1,2}\.\d{4}"
    r"|\d{1,2}/\d{4}"
