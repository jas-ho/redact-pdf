    r")\b"
)

# Markers we use to spot pricing/bracket table months that look like
# Steuernummer (e.g. `03/2025`).
MONTH_YEAR_RE = re.compile(r"\b(0?[1-9]|1[0-2])/\d{4}\b")

# Date range without explicit year on each side: e.g. "01.01. - 31.12"
DATE_RANGE_RE = re.compile(
    r"\b\d{1,2}\.\d{1,2}\.?\s*[-–]\s*\d{1,2}\.\d{1,2}\.?\b"
)

# ── Unicode letter classes for European names ────────────────────────────
# Latin-1 Supplement only. Latin Extended-A (Polish, Czech, etc.) has
# interleaved upper/lower codepoints that can't be range-separated cleanly,
# so we exclude it here and rely on GLiNER for those scripts.
NAME_UPPER = r"A-ZÀ-ÖØ-Þ"
NAME_LOWER = r"a-zß-öø-ÿ"
# Name token: starts uppercase, then lowercase/apostrophes/diacritics,
# optional hyphen-or-apostrophe-then-Uppercase suffix (compound names like
# Müller-Schmidt, O'Connor).
NAME_TOKEN = rf"[{NAME_UPPER}][{NAME_LOWER}']*(?:[-'][{NAME_UPPER}][{NAME_LOWER}']*)*"

# ── Multilingual anchor groups ───────────────────────────────────────────
# Keywords that introduce a date of birth in various languages.
DOB_ANCHORS = (
    # `\bgeb\b` anchors on both sides of the abbreviation. The right-side
    # \b prevents matching `Gebucht`/`Gebühr`/`Gebäude` (both `b` and `u`
    # are word chars → no boundary), while still allowing `geb`, `geb.`,
    # `geb:`, `geb am`, `geb. am`.
    r"\bgeb\b\.?(?:\s*am)?"
    r"|\bgeboren(?:\s*am)?"
    r"|\bGeburtsdatum"
    r"|\bGeb\.?-?\s*Dat(?:um)?"
    r"|\bborn(?:\s+on)?"
    r"|\bDOB"
    r"|\bdate\s+of\s+birth"
    r"|\bn[ée]{1,2}\s+le"
    r"|\bnacid[ao]\s+el"
    r"|\bfecha\s+de\s+nacimiento"
    r"|\bnat[ao]\s+il"
    r"|\bdata\s+di\s+nascita"
    r"|\bnascid[ao]\s+em"
)

# Maiden / former / "born as" surname anchors. Note we keep `geb.` and
# `geboren` here because German has the ambiguous overloading (`geb. Schmidt`
# = "née Schmidt"; `geb. 14.03.1985` = "born 1985"). Disambiguation happens
# via the value pattern: maiden values are uppercase NAME_TOKENs, DOB values
# are date shapes, and `reject_regex_match` rejects function-word captures.
MAIDEN_ANCHORS = (
    r"\bgeb\."
    r"|\bgeboren(?:e[rn]?)?\b"       # geboren, geborene, geborener, geborenen
    r"|\bgeboren\s+als\b"
    r"|\bn[ée]{1,2}\b"
    r"|\bborn\s+(?:as|n[ée]e?)\b"
    r"|\bformerly\s+(?:known\s+)?as\b"
    r"|\bFKA\b"
    r"|\bnacid[ao]\s+como\b"
    r"|\bnat[ao]\s+come\b"
)

# Account / customer / contract / reference number anchors. The anchor must
# end at a word boundary (so `Konto` ≠ `Kontoauszug`) and is followed by an
# explicit separator before the captured value.
ACCOUNT_ANCHORS = (
    # DE: accept abbreviated "-Nr.?" AND full "-nummer" forms.
    r"Kunden(?:-?Nr\.?|nummer)|Vertrags(?:-?Nr\.?|nummer)|"
    r"Konto(?:-?Nr\.?|nummer|\s+Nr\.?)?|"
    r"Mandats?-?(?:referenz|nummer)|Mitglieds(?:-?Nr\.?|nummer)|"
    r"Polizzen(?:-?Nr\.?|nummer)|"
    r"CreditorID|Order(?:nungs)?-?Nr\.?|Auftrags(?:-?Nr\.?|nummer)|"
    r"Referenz(?:-?Nr\.?|nummer)|Ticket(?:-?Nr\.?|nummer)|"
    r"BLZ|VSN|"
    # EN: require disambiguator like 'no'/'number'/'ID' after short prefixes.
    r"Account\s+(?:number|no\.?|#|ID)|Acct\.?\s+(?:no\.?|#|ID)|"
    r"Ref(?:erence)?\.?\s+(?:no\.?|number|#)|"
    r"Order\s+(?:ID|no\.?|#)|Customer\s+(?:ID|no\.?)|"
    r"Member\s+(?:ID|no\.?)|Policy\s+(?:no\.?|number)|"
    # FR: including N° / Nº abbreviations
    r"Num[ée]ro\s+(?:de\s+)?(?:compte|client|r[ée]f[ée]rence|commande|"
    r"contrat|police)|"
    r"N[°ºo]\.?\s+(?:de\s+)?(?:compte|client|r[ée]f[ée]rence)|"
    # ES
    r"N[úu]mero\s+(?:de\s+)?(?:cuenta|cliente|referencia|pedido|contrato|"
    r"p[óo]liza)|"
    r"N[°ºo]\.?\s+(?:de\s+)?(?:cuenta|cliente)|"
    # IT
    r"Numero\s+(?:di\s+)?(?:conto|cliente|riferimento|ordine|contratto|"
    r"polizza)|"
    # PT
    r"N[úu]mero\s+(?:de\s+)?(?:conta|cliente|refer[êe]ncia|pedido|contrato|"
    r"ap[óo]lice)"
)

# Field labels are context, not values. Reuse the multilingual ID/DOB
# anchors and detector labels so this guard also covers overlap fragments.
FIELD_LABEL_RE = re.compile(
    rf"(?:{ACCOUNT_ANCHORS}|{DOB_ANCHORS}|"
    + "|".join(re.escape(label) for label in LABELS_CORE + LABELS_STRICT_EXTRA)
    + r"|BIC|SWIFT(?:[- /]BIC)?|Tel(?:efon|ephone)?|Telefonnummer|"
      r"E[- ]?Mail(?:[- ]?Adresse)?|UID|VAT(?:[- ]?ID)?|"
      r"Steuernummer|Steuer[- ]?ID|IBAN[- ]?Nummer)",
    re.IGNORECASE,
)
FIELD_PREFIX_RE = re.compile(
    rf"^(?:{FIELD_LABEL_RE.pattern})(?!\w)\.?(?:\s*[:;#]\s*|\s+)",
    re.IGNORECASE,
)
FIELD_EXPLICIT_PREFIX_RE = re.compile(
    rf"^(?:{FIELD_LABEL_RE.pattern})(?!\w)\.?\s*[:;#]\s*", re.IGNORECASE,
)
# Words such as Swift/Born and Tel (Aviv) can be real names or places.
# For these detector types, require an explicit field separator.
NAME_PLACE_LABELS = {"person", "company", "organization", "city", "country",
                     "street address", "full address"}

PERSON_TITLE_RE = re.compile(
    r"^(?:(?:Dr|Mr|Mrs|Ms|Prof(?:essor)?|Sr|Sra|"
    r"Frau|Herrn?|Madame|Monsieur|Mlle|Sig(?:\.ra)?|"
    r"Mag(?:\.a)?|Dipl(?:\.-Ing)?|Ing|(?-i:DI)|MMag|"
    r"Univ\.?-?Prof|BSc|MSc|LL\.?M|MBA|PhD)\.?\s+)+",
    re.IGNORECASE,
)
PERSON_SUFFIX_RE = re.compile(
    r"(?:BSc|MSc|LL\.?M|MBA|PhD|jun|sen|jr|sr)\.?",
    re.IGNORECASE,
)


def person_name(surface: str) -> str:
    """Canonical spelling without leading salutations/titles."""
    return PERSON_TITLE_RE.sub("", normalize(surface)).strip(" .,;:()")


def surname_of(cleaned: str) -> str:
    """Ignore trailing qualifications for ambiguity checks, not identity."""
    tokens = [token.strip(".,;:()") for token in cleaned.split()]
    # Leave at least a given name and surname: Sen/Jun can be surnames.
    while len(tokens) > 2 and PERSON_SUFFIX_RE.fullmatch(tokens[-1]):
        tokens.pop()
    return tokens[-1]


# Structured ID patterns. Each: (label, regex). Capture group convention: if
# the pattern uses a capture group, ONLY that group is redacted; otherwise
# the whole match. Surface is validated by `reject_regex_match`.
PRE_PATTERNS: List[Tuple[str, "re.Pattern[str]"]] = [
    # Date of birth anchored by a multilingual keyword. Only the date is
    # redacted, the keyword is preserved.
    ("date_of_birth", re.compile(
        rf"(?:(?i:{DOB_ANCHORS}))"
        r"[:\s.]*(\d{1,2}\.\d{1,2}\.\d{2,4}|\d{1,2}/\d{1,2}/\d{2,4}|\d{4}-\d{2}-\d{2})"
    )),
    # Maiden / former surname after a multilingual "born as" keyword.
    # Anchors are case-insensitive (scoped (?i:...) inline) but NAME_TOKEN
    # stays case-SENSITIVE: otherwise lowercase function words like `am`
    # (DE) or `le` (FR) would match `[A-Z][a-z]+` under global IGNORECASE.
    ("maiden_name", re.compile(
        rf"(?:(?i:{MAIDEN_ANCHORS}))\s+({NAME_TOKEN}(?:\s+{NAME_TOKEN}){{0,3}})"
    )),
    ("policy_number", re.compile(r"\b\d{3}/\d{6,8}-\d\b")),
    ("iban", re.compile(r"\b[A-Z]{2}\d{2}(?:[ ]?[A-Z0-9]{4}){3,7}[ ]?[A-Z0-9]{0,4}\b")),
    # BIC: 4 alpha + valid country + 2 loc + optional 3 branch.
    ("bic", re.compile(rf"\b[A-Z]{{4}}(?:{COUNTRIES})[A-Z0-9]{{2}}(?:[A-Z0-9]{{3}})?\b")),
    # EU VAT IDs: ATU + 8 digits, DE + 9, plus generic country-coded variants.
    ("vat_id", re.compile(
        rf"\b(?:ATU\d{{8}}|DE\d{{9}}|(?:{COUNTRIES})\d{{8,12}})(?=\b|\W|$)"
    )),
    # German Steuernummer state-format. Require slashes on BOTH sides
    # (NNNN/NNNNN/NNNNN) to avoid grabbing MM/YYYY pricing brackets.
    ("tax_number", re.compile(r"\b\d{2,4}/\d{3,5}/\d{4,5}\b")),
    # Austrian SVNr: 4 digits + valid DDMMYY.
    ("social_security_number", re.compile(
        r"\b\d{4}[\s-]?(?:0[1-9]|[12]\d|3[01])(?:0[1-9]|1[0-2])\d{2}\b"
    )),
    # German Steuer-ID: 11 digits, digit-only lookarounds (filenames!).
    ("tax_identification_number", re.compile(r"(?<!\d)\d{11}(?!\d)")),
    # Long digit IDs (12-32 digits): tickets, mandate refs, customer numbers.
    ("long_id", re.compile(r"(?<!\d)\d{12,32}(?!\d)")),
    # DE Personalausweis (T + 9 digits, etc.)
    ("national_identification_number", re.compile(r"\b[A-Z]\d{8}\b")),
    # Customer/contract/account numbers explicitly labeled (multilingual).
    # Anchors are case-insensitive but the captured ID stays case-sensitive
    # (so we don't match lowercase compound-word fragments). The separator
    # `[:\s.#]+` is REQUIRED (not optional), preventing `Kontoauszug` from
    # being treated as `Konto` + `auszug`. The captured value must contain
    # at least one digit: see reject_regex_match.
    ("customer_number", re.compile(
        rf"\b(?:(?i:{ACCOUNT_ANCHORS}))[:\s.#]+([A-Z0-9][A-Z0-9/-]{{4,}})\b"
    )),
    ("email", re.compile(r"\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}\b")),
    # HTTP(S) URLs and bare www. URLs. GLiNER's `url` label sometimes misses
    # these in synthesized markdown links.
    ("url", re.compile(
        r"\bhttps?://[^\s)>\"'\]]+|"
        r"\bwww\.[A-Za-z0-9.-]+\.[A-Za-z]{2,}(?:/[^\s)>\"'\]]*)?"
    )),
    ("phone_number", re.compile(
        r"(?<![\w\d])"
        r"(?:\+\d{1,3}[\s./()-]*|\b0)"
        r"\d[\d\s./()-]{6,18}\d"
        r"(?![\w\d])"
    )),
]


# ── helpers ───────────────────────────────────────────────────────────────

_ZWS_RE = re.compile(
    "[­​‌‍⁠﻿]"
)


def normalize_unicode(s: str) -> str:
    """NFC-normalize and strip zero-width / soft-hyphen chars. Idempotent."""
    return _ZWS_RE.sub("", unicodedata.normalize("NFC", s))


def normalize(s: str) -> str:
    # NFC + zero-width strip so that entity_map keys and downstream matches
    # share a canonical form (composed Müller, not decomposed Mu+̈ller).
    return re.sub(r"\s+", " ", normalize_unicode(s)).strip()


# Leading articles across supported languages. The strip is applied ONLY
# as a normalization before ROLE_NOUN checks: it never affects what we
# alias or redact, so over-stripping ("Le Pen" → "Pen") cannot cause leaks.
_ARTICLES_RE = re.compile(
    r"^\s*(?:"
    r"der|die|das|den|dem|des|"                # DE definite
    r"ein|eine|einer|einem|einen|eines|"       # DE indefinite
    r"the|an?|"                                # EN
    r"le|la|les|un|une|du|"                    # FR
    r"el|los|las|unos|unas|"                   # ES (un/una covered by FR)
    r"il|lo|i|gli|uno|"                        # IT
    r"o|os|as|um|uma|uns|umas"                 # PT
    r")\s+",
    re.IGNORECASE,
)
# FR / IT elided articles (l'/d'/un'/qu'). Straight + Unicode apostrophe.
_APOS_ARTICLE_RE = re.compile(r"^\s*(?:l|d|un|qu)['’]", re.IGNORECASE)


def strip_articles(s: str) -> str:
    """Strip leading articles + zero-width chars + soft hyphens. Used to
    canonicalize a surface before role-noun comparison. Iterates so that
    'der die …' (Docling glitches) collapses."""
    s = normalize_unicode(s)
    prev = ""
    while prev != s:
        prev = s
        s = _ARTICLES_RE.sub("", s)
        s = _APOS_ARTICLE_RE.sub("", s)
    return s.strip()


# German/Scandinavian transliterations applied before NFKD so we keep
# legible filenames (Schäfer → schaefer, not schafer).
_TRANSLIT = str.maketrans({
    "ä": "ae", "ö": "oe", "ü": "ue", "ß": "ss",
    "Ä": "Ae", "Ö": "Oe", "Ü": "Ue",
    "å": "aa", "Å": "Aa", "æ": "ae", "Æ": "Ae",
    "ø": "oe", "Ø": "Oe",
})


def slug(text: str, max_len: int = 60) -> str:
    """Filename-safe slug. Transliterates German/Scandinavian diacritics
    explicitly (ä→ae, ß→ss, …) before NFKD strips the rest."""
    text = text.translate(_TRANSLIT)
    text = unicodedata.normalize("NFKD", text)
    text = text.encode("ascii", "ignore").decode("ascii")
    text = re.sub(r"[^a-zA-Z0-9]+", "-", text).strip("-").lower()
    return text[:max_len].rstrip("-") or "redacted"


def log(tag: str, msg: str, *, json_mode: bool = False, level: str = "INFO") -> None:
    if json_mode:
        print(json.dumps({"level": level, "tag": tag, "msg": msg}), file=sys.stderr)
    else:
        print(f"{level}[{tag}]: {msg}", file=sys.stderr)


def file_content_hash(path: Path, length: int = 8) -> str:
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(65536), b""):
            h.update(chunk)
    return h.hexdigest()[:length]


def atomic_write(path: Path, data: str, *, mode: int = 0o644) -> None:
    """Atomic write. Refuses to follow symlinks. Verifies target is a regular
    file after replace (defense against TOCTOU symlink-swap)."""
    if path.is_symlink():
        raise OSError(f"refusing to write through symlink: {path}")
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=".redact-", dir=path.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(data)
        os.chmod(tmp, mode)
        os.replace(tmp, path)
        st = os.lstat(path)
        from stat import S_ISREG
        if not S_ISREG(st.st_mode):
            raise OSError(f"target is not a regular file after write: {path}")
    except Exception:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


class RenameMode(str, Enum):
    keep = "keep"
    auto = "auto"
    ask = "ask"
    hash = "hash"


class RedactionError(Exception):
    """Raised when redaction cannot guarantee a safe output."""


class Span(NamedTuple):
    start: int
    end: int
    label: str
    surface: str
    source: str   # "regex" or "gliner"
    score: float


# ── span validation ──────────────────────────────────────────────────────

def looks_like_date(s: str) -> bool:
    return bool(DATE_SHAPE_RE.fullmatch(s.strip()))


def looks_like_amount(s: str) -> bool:
    return bool(re.fullmatch(r"\d{1,3}(?:[.,]\d{3})*(?:[.,]\d{1,3})?", s.strip()))


_YEAR_SUFFIX_RE = re.compile(r"\.(19|20)\d{2}\b")
# OCR garbage heuristic: 4+ consonants without vowel.
_CONSONANT_RUN_RE = re.compile(r"[bcdfghjklmnpqrstvwxz]{4,}", re.IGNORECASE)

# German/Austrian legal-document role nouns that GLiNER frequently mislabels
# as `person` / `company` / `organization`. They're not PII and aliasing them
# destroys document semantics. Lowercase comparison.
ROLE_NOUNS = {
    "anwesende", "anwesenden", "beteiligte", "beteiligten",
    "eigentümer", "eigentümerin", "eigentumer",
    "schuldner", "schuldnerin",
    "gläubiger", "glaeubiger", "gläubigerin", "glaeubigerin",
    "kreditnehmer", "kreditnehmerin",
    "ehegatte", "ehegattin", "ehepartner",
    "antragsteller", "antragstellerin",
    "versicherte", "versicherten", "versicherter",
    "versicherungsnehmer", "versicherungsnehmerin",
    "kunde", "kundin", "kunden",
    "mieter", "mieterin", "vermieter", "vermieterin",
    "käufer", "kaeufer", "verkäufer", "verkaeufer",
    "auftraggeber", "auftragnehmer",
    "begünstigter", "beguenstigter",
    "bezugsberechtigte", "bezugsberechtigten",
    "person", "personen", "personenart",
    "patient", "patientin", "patienten",
    "zeuge", "zeugin",
    # FR
    "client", "cliente", "clients",
    # ES
    "cliente", "clientes", "deudor", "acreedor",
}

# Product/tariff tier nouns Docling tables often contain. GLiNER sometimes
# tags these as `person` (e.g., "Premium" alone in a cell). Narrow-filtered:
# only rejected when the surface is a SINGLE token with no title prefix
# nearby. A real Mr./Frau Klein still gets caught via the multi-token /
# titled-token paths.
# Excluded common-surname risks: "klein", "mittel", "groß", "gross",
# "gold", "silber", "bronze": these are legitimate German surnames; a
# table cell containing just the surname could leak if we filtered it
# here. Keep only tier names that are extremely unlikely to be surnames.
TIER_NOUNS = {
    "basis", "standard", "premium", "basic", "classic",
    "platin", "platinum",
    "komfort", "komfortplus", "komfortpaket", "exklusiv", "exklusivpaket",
    "economy", "business", "premiumpaket", "basispaket",
    "aktivplus", "aktivpaket", "starter", "starterpaket",
}


def reject_regex_match(label: str, surface: str) -> bool:
    surface = surface.strip()
    if label == "phone_number":
        if looks_like_date(surface):
            return True
        if _YEAR_SUFFIX_RE.search(surface):
            return True
        if DATE_RANGE_RE.search(surface):
            return True
        digits = re.sub(r"\D", "", surface)
        if (len(set(digits)) <= 1
                or digits.count("0") >= max(1, int(len(digits) * PHONE_ZERO_RATIO))):
            return True
    if label == "tax_number":
        # Reject MM/YYYY pricing brackets that match the short form.
        if MONTH_YEAR_RE.fullmatch(surface):
            return True
    if label == "tax_identification_number":
        digits = surface
        if len(set(digits)) <= 2:
            return True
    if label == "long_id":
        if len(set(surface)) <= 2:
            return True
    if label == "customer_number":
        # Must contain at least one digit (otherwise it's a word fragment).
        if not any(c.isdigit() for c in surface):
            return True
    return False


def reject_gliner_hit(label: str, surface: str) -> bool:
    surface = surface.strip()
    if not surface or len(surface) < MIN_SURFACE_LEN:
        return True
    if ((label not in NAME_PLACE_LABELS or surface.endswith((":", ";", "#")))
            and FIELD_LABEL_RE.fullmatch(surface.strip(" .:;#"))):
        return True
    if surface.lower() in STOPWORDS:
        return True
    if PLACEHOLDER_RE.search(surface):
        return True
    if looks_like_amount(surface):
        return True
    # Reject date-shaped surfaces ONLY for non-date labels (so DOB still works).
    if label != "date of birth" and looks_like_date(surface):
        return True
    if label == "person" and len(surface) < MIN_PERSON_SURFACE:
        return True
    if surface.isupper() and len(surface) < 6 and label in ("person", "company", "organization"):
        return True
    # Reject role nouns mislabeled as person/company/organization. These
    # legal/administrative role words are not PII and aliasing them across
    # the doc would merge unrelated occurrences into one placeholder.
    # `strip_articles` covers "die Versicherungsnehmerin" → "Versicherungsnehmerin".
    if label in ("person", "company", "organization"):
        canon = strip_articles(surface).lower().strip(".,;:")
        if canon in ROLE_NOUNS:
            return True
        # Multi-token role phrases that the whole-surface check misses, e.g.
        # "Endnutzer oder Käufer", "dessen Sohn". Only reject if the surface
        # is PURELY a role/relation phrase: if it also contains a Title-Case
        # proper-noun-looking token (like "Patient: Dr. Anna Beispiel"), keep
        # the span so the name gets aliased. Codex P1.
        all_tokens = [
            t.strip(".,;:") for t in re.split(r"[\s/()\[\]]+", canon) if t
        ]
        if len(all_tokens) >= 2 and any(t in ROLE_NOUNS for t in all_tokens):
            proper_tokens = [
                t for t in re.split(r"[\s/()\[\]:,]+", surface) if t
                and len(t.strip(".")) >= 3
                and t[0].isupper()
                and any(c.islower() for c in t)
                and t.lower().strip(".") not in ROLE_NOUNS
                and t.lower().strip(".") not in STOPWORDS
            ]
            if not proper_tokens:
                return True
        # Tariff-tier nouns alone in a cell (no spaces) are almost always
        # product tiers, not people. Multi-token like "Anna Klein" hits the
        # alias path, so the surname still gets caught via the title-prefixed
        # full name elsewhere in the doc.
        if (label == "person"
                and " " not in canon
                and "-" not in canon
                and canon in TIER_NOUNS):
            return True
    # OCR garbage: only reject if the entire surface lacks vowels (German has
    # long consonant clusters like "Strübel" or "Pfister" that are NOT OCR
    # garbage). Real garbage strings tend to be all-consonant or near-it.
    # Surfaces containing a digit are exempt: account, passport and other ID
    # numbers are vowel-free by nature and must not be dropped. Exception:
    # "date of birth", where GLiNER tags arbitrary numeric dates (signature
    # dates, start dates) as DOB; real DOBs come from the anchored regex.
    if ((label == "date of birth" or not re.search(r"\d", surface))
            and not re.search(r"[aeiouäöüáéíóúàèìòù]", surface, re.IGNORECASE)):
        if len(surface) >= 6:
            return True
    return False


def trim_leading_role_prefix(text: str, start: int, end: int) -> Tuple[int, int]:
    """Advance `start` past leading role-noun tokens followed by punctuation/
    whitespace. Converts e.g. "Patient: Dr. Anna Beispiel" → "Dr. Anna
    Beispiel", so the entity_map key is the actual name and `add_name_aliases`
    can extract the surname properly.

    Pure name spans (no leading role noun) are unaffected. Pure role phrases
    like "Endnutzer oder Käufer" have no leading role-noun in ROLE_NOUNS so
    nothing is trimmed; they remain as cosmetic placeholders without leaking.
    """
    while start < end:
        rest = text[start:end]
        # Either: word + optional whitespace + delimiter + optional whitespace,
        # or: word + required whitespace (for delimiter-less "Patient Anna…").
        m = re.match(r"^(\S+?)\s*[:;,]\s*|^(\S+?)\s+", rest)
        if not m:
            break
        word = (m.group(1) or m.group(2) or "").strip(".,;:")
        if word.lower() not in ROLE_NOUNS:
            break
        start += m.end()
    return start, end


# ── core redactor ─────────────────────────────────────────────────────────

# Labels we trust as "strong identifiers": regex match wins over GLiNER.
STRONG_REGEX_LABELS = {
    "policy_number", "iban", "bic", "vat_id", "email",
    "tax_identification_number", "tax_number", "social_security_number",
    "long_id", "national_identification_number", "customer_number",
}

# Pre-pattern labels considered "context-dependent": only redacted with
# --strict. BIC identifies a bank, VAT identifies a company, URLs are
# usually public references. By default we keep them visible.
STRICT_ONLY_REGEX_LABELS = {"bic", "vat_id", "url"}


class Redactor:
    def __init__(self, model, labels: List[str], threshold: float, *,
                 strict: bool = False):
        self.model = model
        self.labels = labels
        self.threshold = threshold
        self.strict = strict
        self.entity_map: Dict[str, str] = {}
        self.counters: Dict[str, int] = {}
        self.person_ids: Dict[str, str] = {}
        self.person_redirects: Dict[str, str] = {}

    def _label_slug(self, label: str) -> str:
        return re.sub(r"[^a-z0-9]+", "_", label.lower()).strip("_")

    def _next_id(self, label: str) -> str:
        key = self._label_slug(label)
        self.counters[key] = self.counters.get(key, 0) + 1
        return f"[{key}-{self.counters[key]}]"

    def _placeholder_for(self, key: str, label: str) -> str:
        if key not in self.entity_map:
            if label == "person":
                canon = person_name(key).casefold()
                if canon not in self.person_ids:
                    self.person_ids[canon] = self._next_id(label)
                self.entity_map[key] = self.person_ids[canon]
            else:
                self.entity_map[key] = self._next_id(label)
        return self.entity_map[key]

    def _collect_regex_spans(self, text: str) -> List[Span]:
        spans: List[Span] = []
        for label, pattern in PRE_PATTERNS:
            if label in STRICT_ONLY_REGEX_LABELS and not self.strict:
                continue
            for m in pattern.finditer(text):
                if m.lastindex:
                    start, end = m.start(1), m.end(1)
                else:
                    start, end = m.start(), m.end()
                # URL trailing-punctuation trim: ".,;:!?)]" don't belong to URLs.
                if label == "url":
                    while end > start and text[end - 1] in ".,;:!?)]>":
                        end -= 1
                surface = text[start:end]
                if not surface or reject_regex_match(label, surface):
                    continue
                spans.append(Span(start, end, label, surface, "regex", 1.0))
        return spans

    def _collect_gliner_spans(self, text: str) -> List[Span]:
        if not text.strip():
            return []
        try:
            ents = self.model.predict_entities(text, self.labels, threshold=self.threshold)
        except Exception as exc:
            raise RedactionError(f"GLiNER prediction failed: {exc}") from exc
        spans: List[Span] = []
        for e in ents:
            start = e.get("start")
            end = e.get("end")
            # Validate offsets: model can in principle return garbage.
            if not isinstance(start, int) or not isinstance(end, int):
                continue
            if start < 0 or end <= start or end > len(text):
                continue
            # GLiNER can include "IBAN " / "E-Mail: " in the value span.
            # Trim before overlap resolution, preserving label punctuation
            # and spacing even when the value has no regex detector.
            label = e.get("label", "misc")
            prefix_re = (FIELD_EXPLICIT_PREFIX_RE if label in NAME_PLACE_LABELS
                         else FIELD_PREFIX_RE)
            prefix = prefix_re.match(text[start:end])
            if prefix:
                start += prefix.end()
            surface = text[start:end]  # canonical, ignore e["text"]
            score = float(e.get("score") or 0.0)
            # Per-label score floor for labels that the model over-fires on
            # (see PER_LABEL_THRESHOLDS).
            min_score = PER_LABEL_THRESHOLDS.get(label, self.threshold)
            if score < min_score:
                continue
            if reject_gliner_hit(label, surface):
                continue
            # Trim leading role-noun prefix from person/company/organization
            # spans so labeled forms like "Patient: Dr. Anna Beispiel" yield
            # an entity_map key of "Dr. Anna Beispiel": the surname can
            # then be aliased via the title-prefix path.
            if label in ("person", "company", "organization"):
                t_start, t_end = trim_leading_role_prefix(text, start, end)
                if t_end - t_start >= MIN_SURFACE_LEN:
                    start, end = t_start, t_end
                    surface = text[start:end]
            spans.append(Span(start, end, label, surface, "gliner", score))
        return spans

    def _resolve_overlaps(self, spans: List[Span]) -> List[Span]:
        """Resolve overlaps by SPLITTING lower-priority spans around accepted
        higher-priority spans, not by dropping them outright. This prevents
        non-overlapping PII (the un-overlapped part of a larger span) from
        being silently lost."""
        def priority(s: Span):
            strong = (s.source == "regex" and s.label in STRONG_REGEX_LABELS)
            return (1 if strong else 0, s.end - s.start, s.score)

        ranked = sorted(spans, key=lambda s: priority(s), reverse=True)
        kept: List[Span] = []
        for span in ranked:
            pieces = [(span.start, span.end)]
            for k in kept:
                next_pieces = []
                for s, e in pieces:
                    if k.end <= s or k.start >= e:
                        next_pieces.append((s, e))
                    else:
                        if s < k.start:
                            next_pieces.append((s, k.start))
                        if k.end < e:
                            next_pieces.append((k.end, e))
                pieces = next_pieces
            for s, e in pieces:
                if e - s < MIN_SURFACE_LEN:
                    continue
                # Build new span for the piece (surface may differ from original
                # if it was split). Re-validate as a GLiNER-style hit.
                # We re-use the original label/source/score.
                kept.append(Span(s, e, span.label, "", span.source, span.score))
        # Surfaces will be re-sliced from the original text in `redact`.
        return kept

    def redact_chunk(self, text: str) -> str:
        """Redact one text chunk. Raises RedactionError on NER failure."""
        if not text:
            return text
        spans = self._collect_regex_spans(text) + self._collect_gliner_spans(text)
        spans = self._resolve_overlaps(spans)
        for span in sorted(spans, key=lambda s: -s.start):
            surface = text[span.start:span.end]
            key = normalize(surface)
            if not key or len(key) < MIN_SURFACE_LEN:
                continue
            # Re-validate only GLiNER spans (regex spans went through
            # reject_regex_match already). After span-splitting a GLiNER hit
            # may have shrunk into something label-incompatible.
            if span.source == "gliner" and reject_gliner_hit(span.label, key):
                continue
            placeholder = self._placeholder_for(key, span.label)
            text = text[:span.start] + placeholder + text[span.end:]
        return text

    # backward-compat alias
    redact = redact_chunk

    def apply_pre_patterns_only(self, text: str) -> str:
        """Regex-only pass (no GLiNER). Used on rendered markdown to catch IDs
        that appear in Docling-synthesized links/tables the per-item redactor
        never saw. Same length floor as the chunk pass, to avoid registering
        tiny captures like `le` or `am` that slip through specific patterns."""
        spans = self._collect_regex_spans(text)
        # Resolve overlaps (regex-only: most will be disjoint anyway).
        spans = self._resolve_overlaps(spans)
        for span in sorted(spans, key=lambda s: -s.start):
            surface = text[span.start:span.end]
            key = normalize(surface)
            if not key or len(key) < MIN_SURFACE_LEN:
                continue
            placeholder = self._placeholder_for(key, span.label)
            text = text[:span.start] + placeholder + text[span.end:]
        return text

    def redact_anchored_table_cells(self, markdown: str) -> str:
        """Markdown post-pass for tables where an anchor (e.g. `Geburtsdatum`)
        is in one cell and the value (e.g. `08.05.1985`) is in another cell.
        The per-item redactor and `apply_pre_patterns_only` regex are
        single-line and miss this layout. Two patterns covered:

          1. Row-local key-value (2-col):
                | Geburtsdatum | 08.05.1985 |
             Anchor in cell 0, value in cell 1.

          2. Column-propagated (header + data rows):
                | Vorname | Geburtsdatum | Beginn |
                |---------|--------------|--------|
                | Anna    | 08.04.1993   | 01.03  |
             Anchor in header at column 1, values in column 1 of data rows.

        DOB anchors also work row-locally. Name anchors only propagate down
        a column under an exact header match, so a generic `Name` label
        cannot cause neighboring tariff or role columns to be redacted.
        """
        # (label, anchor_regex, value_regex)
        anchors = [
            ("date_of_birth",
             re.compile(rf"(?i:{DOB_ANCHORS})"),
             re.compile(
                 r"\b\d{1,2}\.\d{1,2}\.\d{2,4}\b"
                 r"|\b\d{1,2}/\d{1,2}/\d{2,4}\b"
                 r"|\b\d{4}-\d{2}-\d{2}\b")),
            ("person",
             re.compile(
                 r"(?i)^\s*[*_]*(?:"
                 r"name|vorname|nachname|familienname|"
                 r"versicherte\s+person(?:en)?|mitglied|"
                 r"full\s+name|first\s+name|last\s+name|surname|given\s+name|"
                 r"nom|prénom|prenom|nom\s+de\s+famille|"
                 r"nombre|apellidos?"
                 r")[*_]*\s*:?\s*$"),
             # Match existing placeholders first, then Unicode name runs
             # (including short names, initials and compound surnames).
             re.compile(
                 rf"{PLACEHOLDER_RE.pattern}|"
                 r"[^\W\d_]+(?:[ \t.'’\-]+[^\W\d_]+)*")),
        ]

        def is_table_row(s: str) -> bool:
            t = s.strip()
            return t.startswith("|") and t.count("|") >= 2

        sep_re = re.compile(r"^\s*\|(?:\s*:?-{2,}:?\s*\|)+\s*$")

        def split_cells(s: str) -> Tuple[str, str, List[str]]:
            t = s
            # Preserve any leading whitespace before the first `|` so we
            # can rebuild the line faithfully.
            lead_ws_len = len(t) - len(t.lstrip())
            lead = t[:lead_ws_len]
            body = t[lead_ws_len:]
            lpipe = "|" if body.startswith("|") else ""
            if lpipe:
                body = body[1:]
            rpipe = "|" if body.endswith("|") else ""
            if rpipe:
                body = body[:-1]
            return lead + lpipe, rpipe, body.split("|")

        def _replace_in_cell(cell: str, value_re, label: str) -> str:
            def _sub(m):
                surface = m.group(0)
                key = normalize(surface)
                if PLACEHOLDER_RE.fullmatch(surface):
                    return surface
                if label == "person":
                    canon = strip_articles(key).lower().strip(".,;:")
                    if canon in ROLE_NOUNS or canon in TIER_NOUNS:
                        return surface
                elif len(key) < MIN_SURFACE_LEN:
                    return surface
                return self._placeholder_for(key, label)
            return value_re.sub(_sub, cell)

        lines = markdown.splitlines()
        i = 0
        while i < len(lines):
            if not is_table_row(lines[i]):
                i += 1
                continue
            lead, rpipe, cells = split_cells(lines[i])
            # Find anchor-matching cells (column-major map).
            anchor_cols: Dict[int, Tuple["re.Pattern[str]", str]] = {}
            for col_idx, cell in enumerate(cells):
                for label, anchor_re, value_re in anchors:
                    if anchor_re.search(cell):
                        anchor_cols[col_idx] = (value_re, label)
                        break
            if not anchor_cols:
                i += 1
                continue
            # 1. Row-local: redact value-shaped tokens in OTHER cells.
            for col_idx in range(len(cells)):
                if col_idx in anchor_cols:
                    continue
                for ac_idx, (value_re, label) in anchor_cols.items():
                    if label == "person":
                        continue
                    cells[col_idx] = _replace_in_cell(
                        cells[col_idx], value_re, label
                    )
            lines[i] = lead + "|".join(cells) + rpipe
            # 2. Column-propagated: only if followed by a separator row
            #    (otherwise this isn't a "true" header row).
            if i + 1 < len(lines) and sep_re.match(lines[i + 1]):
                j = i + 2
                while j < len(lines) and is_table_row(lines[j]):
                    lead2, rpipe2, row_cells = split_cells(lines[j])
                    for col_idx, (value_re, label) in anchor_cols.items():
                        if col_idx < len(row_cells):
                            row_cells[col_idx] = _replace_in_cell(
                                row_cells[col_idx], value_re, label
                            )
                    lines[j] = lead2 + "|".join(row_cells) + rpipe2
                    j += 1
                i = j
            else:
                i += 1
        return "\n".join(lines)

    def add_name_aliases(self) -> None:
        """Finalize person aliases after all chunks, tables and metadata.

        Full names share IDs after title/case/whitespace normalization.
        Surname-only mentions join a full name only if its surname is unique
        across the document. Delay that decision until here: a later chunk
        may introduce another person with the same surname.
        """
        people = [(surface, placeholder, person_name(surface))
                  for surface, placeholder in self.entity_map.items()
                  if placeholder.startswith("[person-")]
        surnames: Dict[str, set] = {}
        for surface, placeholder, cleaned in people:
            tokens = cleaned.split()
            if len(tokens) >= 2:
                surnames.setdefault(surname_of(cleaned).casefold(), set()).add(placeholder)

        for surface, placeholder, cleaned in people:
            tokens = cleaned.split()
            if len(tokens) == 1:
                candidates = surnames.get(cleaned.casefold(), set())
                target = placeholder
                if len(candidates) == 1:
                    target = next(iter(candidates))
                    self.person_redirects[placeholder] = target
                    self.entity_map[surface] = target
                    self.person_ids[cleaned.casefold()] = target
                if len(cleaned) >= MIN_SURFACE_LEN:
                    for variant in (cleaned, cleaned.upper()):
                        self.entity_map.setdefault(variant, target)

        # Keep conservative criteria for discovering *undetected* surnames;
        # already detected surname mentions above need no length heuristic.
        for surface, placeholder, cleaned in people:
            tokens = cleaned.split()
            if len(tokens) < 2 or any(
                strip_articles(t).lower().strip(".,;:") in ROLE_NOUNS
                for t in tokens
            ):
                continue
            for variant in (cleaned, cleaned.upper()):
                self.entity_map.setdefault(variant, placeholder)
            last = surname_of(cleaned)
            is_compound = "-" in last and len(last) >= ALIAS_COMPOUND_MIN_LEN
            is_long_titled = (len(last) >= ALIAS_SINGLE_MIN_LEN
                              and PERSON_TITLE_RE.match(normalize(surface)))
            if not (is_compound or is_long_titled):
                continue
            candidates = surnames[last.casefold()]
            # Still redact an undetected ambiguous surname, but give it its
            # own ID rather than arbitrarily attributing it to one person.
            target = (placeholder if len(candidates) == 1
                      else self._placeholder_for(last, "person"))
            for variant in (last, last.upper()):
                self.entity_map.setdefault(variant, target)

    def sweep_recurrences(self, text: str) -> str:
        """Replace any literal occurrence of a known entity_map key. Word-
        boundary anchored; longest keys first to avoid `John` clobbering
        `John Smith`. Skips keys already containing placeholders."""
        # Unify placeholders already emitted before surname ambiguity was
        # known. Exact token substitution avoids person-1/person-10 collisions.
        text = re.sub(r"\[person-\d+\]",
                      lambda m: self.person_redirects.get(m.group(), m.group()), text)
        # Sort by length desc; skip placeholder-shaped or pure-digit keys
        # that the pre-pattern pass will have already covered.
        keys = [k for k in self.entity_map.keys()
                if not PLACEHOLDER_RE.search(k) and not k.isdigit()]
        keys.sort(key=len, reverse=True)
        for key in keys:
            if len(key) < MIN_SURFACE_LEN:
                continue
            placeholder = self.entity_map[key]
            prefix = r"\b" if key[0].isalnum() else ""
            suffix = r"\b" if key[-1].isalnum() else ""
            try:
                text = re.sub(prefix + re.escape(key) + suffix, placeholder, text)
            except re.error:
                continue
        # Additionally: sweep pure-digit keys (account/customer numbers) with
        # digit-only lookarounds so they catch standalone recurrences.
        digit_keys = [k for k in self.entity_map
                      if k.isdigit() and len(k) >= MIN_SURFACE_LEN]
        digit_keys.sort(key=len, reverse=True)
        for key in digit_keys:
            placeholder = self.entity_map[key]
            try:
                text = re.sub(rf"(?<!\d){re.escape(key)}(?!\d)", placeholder, text)
            except re.error:
                continue
        return text


# ── filename PII / naming ─────────────────────────────────────────────────

def filename_has_pii(model, stem: str) -> List[dict]:
    """Detect PII in a filename via both regex pre-patterns AND GLiNER.
    Underscores/dashes are treated as separators; dots are preserved so
    `john.doe@example.com` still matches the email regex."""
    normalized = re.sub(r"[_\-]+", " ", stem)
    findings = []
    for label, pattern in PRE_PATTERNS:
        for m in pattern.finditer(normalized):
            findings.append({"label": label, "text": m.group(0), "source": "regex"})
    try:
        ner = model.predict_entities(
            normalized,
            ["person", "full address", "email", "phone number", "date of birth", "IBAN"],
            threshold=0.4,
        )
        for e in ner:
            findings.append({"label": e["label"], "text": e.get("text", ""), "source": "gliner"})
    except Exception as exc:
        # Don't silently swallow: log so agents can see something went wrong.
        log("filename-pii-detect", f"GLiNER on filename failed: {exc}", level="WARN")
    return findings


def derive_from_content(doc, redactor: Redactor) -> Optional[str]:
    from docling_core.types.doc import TextItem
    candidates: List[str] = []
    for item, _level in doc.iterate_items():
        if isinstance(item, TextItem) and item.text:
            label = str(getattr(item, "label", "") or "").lower()
            if label == "title" and item.text.strip():
                candidates.insert(0, normalize(item.text))
                break
    if not candidates:
        for item, _level in doc.iterate_items():
            if isinstance(item, TextItem) and item.text:
                label = str(getattr(item, "label", "") or "").lower()
                if label in ("section_header", "heading") and len(item.text.strip()) > 6:
                    candidates.append(normalize(item.text))
                if len(candidates) >= 2:
                    break
    if not candidates:
        return None
    candidate = " ".join(candidates)
    try:
        redacted = redactor.redact_chunk(candidate)
    except RedactionError:
        return None
    redacted = re.sub(r"\[[a-z_]+-\d+\]", "", redacted)
    return slug(redacted) or None


def resolve_output_stem(
    *, original_path: Path, doc, redactor: Redactor, model,
    rename: str, json_mode: bool,
) -> Tuple[str, List[dict]]:
    original_stem = original_path.stem
    pii = filename_has_pii(model, original_stem)

    if rename not in {m.value for m in RenameMode}:
        return slug(rename), pii

    mode = RenameMode(rename)

    if mode is RenameMode.keep:
        if pii:
            kinds = sorted({f["label"] for f in pii})
            log("filename-pii",
                f"input filename contains PII ({', '.join(kinds)}); using slug of original. "
                f"Override with --rename ask|auto|hash|<name>.",
                json_mode=json_mode, level="WARN")
        return slug(original_stem), pii

    if mode is RenameMode.hash:
        h = file_content_hash(original_path)
        return f"redacted-{h}", pii

    if mode is RenameMode.auto:
        derived = derive_from_content(doc, redactor)
        if derived:
            return derived, pii
        log("rename-auto", "no usable title/heading; falling back to content hash",
            json_mode=json_mode, level="WARN")
        return f"redacted-{file_content_hash(original_path)}", pii

    if mode is RenameMode.ask:
        if not sys.stdin.isatty():
            log("rename-ask",
                "--rename ask requires a TTY; falling back to --rename keep. "
                "Use --rename auto|hash|<name> in non-interactive contexts.",
                json_mode=json_mode, level="ERROR")
            return slug(original_stem), pii
        derived = derive_from_content(doc, redactor) or ""
        print(f"\nInput filename: {original_stem!r}", file=sys.stderr)
        if pii:
            kinds = sorted({f["label"] for f in pii})
            print(f"  ⚠ contains PII: {kinds}", file=sys.stderr)
        if derived:
            print(f"  suggested:    {derived!r}", file=sys.stderr)
        print("  Enter output stem (blank to keep slug of original): ",
              file=sys.stderr, end="", flush=True)
        answer = sys.stdin.readline().strip()
        return slug(answer) if answer else slug(original_stem), pii

    return slug(original_stem), pii


# ── per-file pipeline ─────────────────────────────────────────────────────

def extract_pdf_metadata(pdf_path: Path) -> Dict[str, str]:
    """Read PDF document properties (/Author, /Title, /Subject, /Keywords).
    These don't appear in the text stream but can leak PII silently if
    someone opens the file's properties pane. We redact + surface them."""
    try:
        import pypdfium2 as pdfium
    except ImportError:
        return {}
    try:
        pdf = pdfium.PdfDocument(str(pdf_path))
        try:
            raw = pdf.get_metadata_dict() or {}
        finally:
            pdf.close()
    except Exception:
        return {}
    return {
        k: v for k, v in raw.items()
        if v and k in ("Author", "Title", "Subject", "Keywords")
    }


_CLOUD_SYNC_ROOTS = (
    "Dropbox",
    "OneDrive",
    "Google Drive",
    "GoogleDrive",
    "iCloud Drive",
    # macOS iCloud Drive on disk:
    "Library/Mobile Documents/com~apple~CloudDocs",
    # macOS-mounted CloudDocs alias:
    "Library/CloudStorage",
    "Sync.com",
    "pCloud Drive",
    "Box Sync",
    "Box",
    "MEGA",
    "Tresorit",
)


def warn_if_cloud_synced(out_dir: Path, *, json_mode: bool) -> None:
    """Emit a WARN if `out_dir` looks like it lives under a cloud-sync root.
    The redacted markdown + entity_map would otherwise be silently uploaded.
    Detection is path-substring only: false positives are fine (a folder
    literally named 'Dropbox' under ~/Code is the user's choice to ignore)."""
    try:
        resolved = out_dir.resolve()
    except (OSError, RuntimeError):
        return
    s = str(resolved)
    for root in _CLOUD_SYNC_ROOTS:
        if f"/{root}/" in s or s.endswith(f"/{root}"):
            log(
                "cloud-sync",
                f"output directory '{resolved}' appears to live under "
                f"'{root}'. The redacted markdown is safe to sync, but the "
                "private '.<stem>.entity_map.json' sibling file (0600) "
                "WILL be uploaded too and contains the original PII. "
                "NEXT: pass --out-dir pointing outside the synced folder, "
                "OR exclude '.*.entity_map.json' from sync in the client's "
                "preferences.",
                json_mode=json_mode, level="WARN",
            )
            return


def _build_converter(ocr: bool):
    """Build a Docling DocumentConverter. OCR off by default (text PDFs only);
    enable with --ocr for scanned PDFs."""
    from docling.document_converter import DocumentConverter, PdfFormatOption
    from docling.datamodel.base_models import InputFormat
    from docling.datamodel.pipeline_options import PdfPipelineOptions
    opts = PdfPipelineOptions(do_ocr=ocr)
    return DocumentConverter(format_options={
        InputFormat.PDF: PdfFormatOption(pipeline_options=opts)
    })


def process_pdf(
    pdf_path: Path, out_dir: Path, model, *, rename: str, threshold: float,
    json_mode: bool, force: bool, strict: bool = False, ocr: bool = False,
) -> dict:
    from docling_core.types.doc import TableItem, TextItem

    converter = _build_converter(ocr)
    result = converter.convert(str(pdf_path))
    doc = result.document
    redactor = Redactor(model, labels_for(strict), threshold, strict=strict)

    n_text = n_table = n_chars = 0
    raw_text_parts: List[str] = []
    for item, _level in doc.iterate_items():
        if isinstance(item, TextItem):
            raw = item.text or ""
            raw_text_parts.append(raw)
            new = redactor.redact_chunk(raw)
            if new != item.text:
                item.text = new
            n_text += 1
            n_chars += len(item.text or "")
        elif isinstance(item, TableItem):
            for row in item.data.table_cells:
                cells = row if isinstance(row, list) else [row]
                for cell in cells:
                    if hasattr(cell, "text") and cell.text:
                        raw_text_parts.append(cell.text)
                        cell.text = redactor.redact_chunk(cell.text)
            n_table += 1

    # Language sanity check (stopword-based; zero new deps). WARN if the
    # detected dominant language is outside the validated/likely-OK set:
    # GLiNER still handles names/emails/IBANs but regex anchors (DOB labels,
    # role nouns, customer-number labels) only fire for {DE,EN,FR,ES,IT,PT}.
    raw_text = " ".join(raw_text_parts)
    detected = detect_language(raw_text)
    if detected is None and len(raw_text) > 200:
        log("language",
            f"{pdf_path.name}: could not confidently detect language. "
            "If the doc is in a language outside DE/EN/FR/ES/IT/PT, "
            "regex anchors (DOB, role nouns, ID labels) may not fire; "
            "GLiNER still handles names/emails/IBANs.",
            json_mode=json_mode, level="WARN")
    elif detected and detected not in SUPPORTED_LANGS:
        log("language",
            f"{pdf_path.name}: detected language '{detected}' is outside "
            "the supported set (DE/EN validated; FR/ES/IT/PT likely OK). "
            "Regex anchors won't fire for this language; GLiNER still "
            "handles names/emails/IBANs.",
            json_mode=json_mode, level="WARN")

    # Heuristic: a text PDF should have ≳ 200 chars per page (a 1-page text
    # PDF typically holds 500-3000 chars). If it's a lot less and OCR is off,
    # the input is probably scanned and the user should pass --ocr.
    n_pages = max(1, len(getattr(doc, "pages", []) or [1]))
    chars_per_page = n_chars / n_pages
    if not ocr and chars_per_page < 200 and n_pages >= 1:
        log("scanned-likely",
            f"{pdf_path.name}: only {n_chars} chars across {n_pages} page(s) "
            f"({chars_per_page:.0f} chars/page). Looks like a scanned PDF. "
            "Re-run with --ocr to extract text from images, "
            "or pre-process with ocrmypdf for higher quality.",
            json_mode=json_mode, level="WARN")

    stem, pii = resolve_output_stem(
        original_path=pdf_path, doc=doc, redactor=redactor, model=model,
        rename=rename, json_mode=json_mode,
    )

    md_path = out_dir / f"{stem}.md"
    # Sibling dot-prefixed secrets file: hidden from `ls`, no subdir clutter,
    # easy to move/delete alongside the .md. Permissions enforced at file
    # level (0600) since there's no shared dir to chmod.
    map_path = out_dir / f".{stem}.entity_map.json"

    if not force:
        for p in (md_path, map_path):
            if p.exists():
                raise RedactionError(
                    f"output exists: {p}. NEXT: rerun with --force to overwrite, "
                    f"--rename <NAME> for a different stem, or remove the file."
                )

    real_out = out_dir.resolve()
    if not real_out.is_dir():
        raise RedactionError(f"out_dir does not resolve to a directory: {out_dir}")

    # ── PDF metadata redaction ──────────────────────────────────────────
    raw_meta = extract_pdf_metadata(pdf_path)
    redacted_meta: Dict[str, str] = {}
    for k, v in raw_meta.items():
        try:
            redacted_meta[k] = redactor.redact_chunk(v) if v else ""
        except RedactionError:
            redacted_meta[k] = "[REDACTED]"
        if redacted_meta[k] != v:
            log("metadata-pii",
                f"{pdf_path.name}: /{k} metadata field contained PII "
                "(redacted in output; original is in the source PDF "
                ": use `exiftool -all= file.pdf` to strip).",
                json_mode=json_mode, level="WARN")

    # ── markdown post-pass ───────────────────────────────────────────────
    # Catches IDs in Docling-synthesized links/markdown the per-item pass
    # never saw, plus literal recurrences of names already in entity_map.
    # Precautionary: blank out Docling's internal name/origin filename fields
    # before export. They normally aren't included in the markdown output but
    # could leak the original (potentially PII-bearing) filename if a future
    # Docling version starts embedding them.
    try:
        if hasattr(doc, "name"):
            doc.name = ""
        origin = getattr(doc, "origin", None)
        if origin is not None and hasattr(origin, "filename"):
            origin.filename = ""
    except Exception:
        pass

    markdown = doc.export_to_markdown()
    # NFC + zero-width strip so entity_map keys (already normalized) match
    # surfaces in the rendered text and so regex patterns aren't broken by
    # invisible chars Docling may pass through from the source PDF.
    markdown = normalize_unicode(markdown)
    markdown = redactor.apply_pre_patterns_only(markdown)
    markdown = redactor.redact_anchored_table_cells(markdown)
    redactor.add_name_aliases()  # alias compound surnames to existing placeholders
    markdown = redactor.sweep_recurrences(markdown)
    # Also sweep recurrences through metadata (e.g., aliased compound surnames).
    redacted_meta = {k: redactor.sweep_recurrences(v) for k, v in redacted_meta.items()}

    # Prepend metadata as YAML frontmatter so the user has a complete view.
    if redacted_meta:
        fm_lines = ["---"]
        for k, v in redacted_meta.items():
            fm_lines.append(f"{k}: {v}")
        fm_lines.append("---")
        markdown = "\n".join(fm_lines) + "\n\n" + markdown

    # Write both files. If the secrets write fails, clean up the markdown
    # so we don't leave a partial output behind.
    atomic_write(md_path, markdown, mode=0o644)
    try:
        atomic_write(
            map_path,
            json.dumps(redactor.entity_map, ensure_ascii=False, indent=2),
            mode=0o600,
        )
    except Exception:
        try:
            md_path.unlink()
        except OSError:
            pass
        raise

    return {
        "input": str(pdf_path),
        "output": str(md_path),
        "entity_map": str(map_path),
        "n_entities": len(redactor.entity_map),
        "n_text_items": n_text,
        "n_tables": n_table,
        "filename_pii": pii,
    }


