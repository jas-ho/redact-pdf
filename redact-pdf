VALIDATED_LANGS = {"de", "en"}
LIKELY_OK_LANGS = {"fr", "es", "it", "pt"}
SUPPORTED_LANGS = VALIDATED_LANGS | LIKELY_OK_LANGS


def detect_language(text: str) -> Optional[str]:
    """Cheap stopword-count language detection. Returns one of the keys in
    `_STOPWORDS_BY_LANG` or None if the text is too short / no language
    dominates. Zero-dep, ~1ms on typical PDF text."""
    tokens = re.findall(r"\b[a-zäöüß]{2,}\b", text.lower())
    if len(tokens) < 50:
        return None
    counts = {
        lang: sum(1 for t in tokens if t in sw)
        for lang, sw in _STOPWORDS_BY_LANG.items()
    }
    ranked = sorted(counts.items(), key=lambda kv: kv[1], reverse=True)
    best_lang, best_count = ranked[0]
    second_count = ranked[1][1] if len(ranked) > 1 else 0
    # Need both a meaningful count AND a clear winner (≥1.5× the runner-up).
    if best_count < 8 or best_count < 1.5 * max(second_count, 1):
        return None
    return best_lang

# Common ISO-3166 alpha-2 codes for BIC/VAT validation. Not exhaustive:
