            # DOB anchor must NOT match `Gebucht`/`Gebühr` prefixes.
            "Gebucht am 15.06.2025",
            "Gebühr 12,50",
        ],
        "default_must_keep": [
            "ATU99999999",                                # VAT
            "TESTAT22XXX",                                # BIC
            "https://www.example.org/privacy",            # URL in markdown link
            "www.example.org/info.html",                  # bare URL
            # URL trailing punctuation: period stays in the sentence, not URL.
            ".html.",
        ],
        "strict_must_remove": [
            "ATU99999999",                                # VAT (redacted strict)
            "TESTAT22XXX",                                # BIC (redacted strict)
            "https://www.example.org/privacy",            # URL (redacted strict)
        ],
    },
    # Unlabeled numeric IDs: vowel-free surfaces that the OCR-garbage filter
    # used to drop. Regex does not cover these shapes, so GLiNER must.
    "IDS": {
        "input": (
            "Bitte überweisen Sie den Betrag auf das Bankkonto 48213377 bei "
            "der Testbank. Der Reisepass des Kunden hat die Nummer P4821337."
        ),
        "must_remove": ["48213377", "P4821337"],
        "must_keep": [],
        "default_must_keep": ["Testbank"],
    },
    # Markdown tables: anchor (e.g. `Geburtsdatum`) and value (a date) in
    # SEPARATE cells. The per-item GLiNER pass and apply_pre_patterns_only
    # are single-line: only redact_anchored_table_cells catches these.
    "TABLES": {
        "input": (
            "# Profil\n\n"
            # 2-col key-value table (row-local case).
            "| Sozialversicherungsnummer | 1111 010180 |\n"
            "| Geburtsdatum              | 08.05.1985  |\n"
            "| Geschlecht                | weiblich    |\n\n"
            # Wide multi-row table (column-propagated case).
            "| Versicherte Personen | Geburtsdatum | Beginn     |\n"
            "|----------------------|--------------|------------|\n"
            "| Anna Beispiel        | 08.04.1993   | 01.03.2025 |\n"
            "| Karl Beispiel        | 14.07.1990   | 01.03.2025 |\n\n"
            # Tariff-tier nouns: TIER_NOUNS filter should keep clearly-not-
            # surnames visible. (Klein/Gross excluded from TIER_NOUNS: they
            # are real surnames; we'd rather over-redact than leak surnames.)
            "| Tarif       | Selbstbehalt |\n"
            "|-------------|--------------|\n"
            "| Standard    | 200          |\n"
            "| Premium     | 500          |\n\n"
            # Surname-in-cell guard (codex P2): a name table where the
            # cell value is a common-surname-shaped token must still be
            # captured as a person, since Klein is a real surname too.
            "Frau Anna Klein hat den Vertrag unterschrieben."
            # Article-prefixed role noun (H3): "Die Versicherungsnehmerin" is
            # NOT a person, should not be aliased.
            "Die Versicherungsnehmerin bestätigt. Der Versicherungsnehmer "
            "unterschreibt."
        ),
        "must_remove": [
            "08.05.1985",     # DOB in 2-col table
            "08.04.1993",     # DOB in wide table, row 1
            "14.07.1990",     # DOB in wide table, row 2
            # Surname Klein, in person context with title, MUST be caught.
            # Checked per component: "Anna Klein" alone would pass if only
            # the first name were removed.
            "Anna Klein", "Klein",
            "Anna", "Karl", "Beispiel",
        ],
        "must_keep": [
            # Beginn dates are NOT DOB: they share the table but the
            # anchor only covers the Geburtsdatum column.
            "01.03.2025",
            # Tariff tier nouns: tables, not names.
            "Standard", "Premium",
            # Article-prefixed role nouns must not be aliased.
            "Versicherungsnehmerin", "Versicherungsnehmer",
        ],
    },
}


def run_selftest(
    model, threshold: float, *, json_mode: bool = False, strict: bool = False,
) -> None:
    """Run all samples as strings through the redaction stages:
    per-item redaction → pre-pattern post-pass → table DOB/name anchoring → name
    aliasing → recurrence sweep. Same order as `process_pdf`, but without
    Docling conversion, per-cell table processing, metadata or file writes."""
    failures: List[str] = []

    # Deterministic model spans exercise wide hits, standalone labels and
    # overlap splitting without depending on GLiNER's probabilistic output.
    class WholeSpanModel:
        def __init__(self, label: str):
            self.label = label

        def predict_entities(self, text, labels, threshold):
            return [{"start": 0, "end": len(text), "label": self.label,
                     "score": 1.0}]

    for surface, label in (("Born", "person"), ("Swift", "person"),
                           ("Iban", "person"), ("Tel Aviv", "city"),
                           ("company.example", "url")):
        red = Redactor(WholeSpanModel(label), labels_for(strict), threshold,
                       strict=strict)
        out = red.redact_chunk(surface)
        if surface not in red.entity_map or out != red.entity_map[surface]:
            failures.append(f"name resembling field label {surface!r}: {out!r}")

    for keyword, value, label in (
        ("IBAN", "AT00 1111 2222 3333 4444", "IBAN"),
        ("BIC", "TESTAT22XXX", "bank account number"),
        ("Tel.", "+43 1 999 99 99", "phone number"),
        ("E-Mail", "anna@beispiel.example", "email"),
        ("Kundennummer", "TST-99887766", "bank account number"),
        ("Account number", "AB123456", "bank account number"),
        ("Geburtsdatum", "14.03.1985", "date of birth"),
    ):
        red = Redactor(WholeSpanModel(label), labels_for(strict), threshold,
                       strict=strict)
        for bare in (keyword, keyword.upper() + ":"):
            if red.redact_chunk(bare) != bare:
                failures.append(f"field label {bare!r}: bare keyword redacted")
        for separator in (" ", ": ", ":"):
            inp = keyword + separator + value
            out = red.redact_chunk(inp)
            red.add_name_aliases()
            out = red.sweep_recurrences(out)
            if (not out.startswith(keyword + separator + "[")
                    or value in out or keyword in red.entity_map):
                failures.append(f"field label {inp!r}: got {out!r}")
        # Even a label left over AFTER splitting must be rejected.
        if not reject_gliner_hit(label, keyword + " "):
            failures.append(f"field label fragment {keyword!r}: accepted")

    variants = [
        "Herrn Mag. Karl Probstmüller", "Karl Probstmüller",
        "KARL PROBSTMÜLLER", "  Karl\t Probstmüller  ",
        "Mr. Dr. Karl Probstmüller", "Mrs. Karl Probstmüller",
        "Ms. Prof. Karl Probstmüller", "Frau Karl Probstmüller",
    ]
    # A surname may precede its full name; a second person may occur only
    # in a later table/metadata chunk. Test both document orders.
    for surname in ("Probstmüller", "Beispiel-Muster", "Li"):
        for ambiguous in (False, True):
            surfaces = [v.replace("Probstmüller", surname)
                        .replace("PROBSTMÜLLER", surname.upper()) for v in variants]
            mentions = [surname.upper(), "Herr " + surname] + surfaces
            if ambiguous:
                mentions.append("Lena " + surname)
            for ordered in (mentions, list(reversed(mentions))):
                red = Redactor(WholeSpanModel("person"), ["person"], threshold,
                               strict=strict)
                outputs = [red.redact_chunk(s) for s in ordered]
                # Table anchoring also registers names (including short ones).
                table = "| Name |\n|---|\n| " + surname.upper() + " |"
                outputs.append(red.redact_anchored_table_cells(table))
                red.add_name_aliases()
                out = red.sweep_recurrences("\n".join(outputs))
                ids = {red.entity_map[normalize(s)] for s in surfaces}
                if len(ids) != 1:
                    failures.append(f"person variants {surname}: {ids}")
                target = red.entity_map[normalize(surfaces[0])]
                bare = red.entity_map[surname.upper()]
                if ambiguous:
                    other = red.entity_map["Lena " + surname]
                    if target == other or bare in (target, other):
                        failures.append(f"ambiguous surname {surname}: merged people")
                elif bare != target or red.entity_map["Herr " + surname] != target:
                    failures.append(f"unique surname {surname}: separate IDs")
                if not ambiguous and set(re.findall(r"\[person-\d+\]", out)) != {target}:
                    failures.append(f"person {surname}: stale IDs in rendered output")
                if len(surname) >= MIN_SURFACE_LEN and surname.casefold() in out.casefold():
                    failures.append(f"person {surname}: raw surname survived")
                if ambiguous and not set(re.findall(r"\[person-\d+\]", out)) <= {target, other, bare}:
                    failures.append(f"person {surname}: unexpected IDs in output")

    for suffix in (",", " BSc", " MSc", " Jr."):
        red = Redactor(WholeSpanModel("person"), ["person"], threshold,
                       strict=strict)
        for surface in ("Karl Probstmüller", "Lena Probstmüller" + suffix,
                        "Herr Probstmüller"):
            red.redact_chunk(surface)
        red.add_name_aliases()
        out = red.sweep_recurrences("Probstmüller / PROBSTMÜLLER")
        ids = {red.entity_map[s] for s in (
            "Karl Probstmüller", "Lena Probstmüller" + suffix, "Herr Probstmüller")}
        if len(ids) != 3 or "probstmüller" in out.casefold():
            failures.append(f"surname punctuation/qualification {suffix!r}: merged or leaked")

    red = Redactor(WholeSpanModel("person"), ["person"], threshold, strict=strict)
    for surface in ("Karl Probstmüller", "Herr Probstmüller"):
        red.redact_chunk(surface)
    red.add_name_aliases()
    if red.sweep_recurrences("Probstmüller") != red.entity_map["Karl Probstmüller"]:
        failures.append("detected titled surname: undetected bare recurrence leaked")
    if person_name("Sig. Di Stefano") != "Di Stefano":
        failures.append("title normalization stripped the name particle Di")
    if surname_of("Amartya Sen") != "Sen" or surname_of("Karl Jun Jr.") != "Jun":
        failures.append("surname normalization stripped a real surname")
    red = Redactor(WholeSpanModel("person"), ["person"], threshold, strict=strict)
    mentions = ("Karl Probstmüller", "M. Probstmüller", "Herr Probstmüller")
    for surface in mentions:
        red.redact_chunk(surface)
    red.add_name_aliases()
    if len({red.entity_map[s] for s in mentions}) != 3:
        failures.append("ambiguous initial M.: merged distinct person mentions")

    for ambiguous in (False, True):
        red = Redactor(WholeSpanModel("person"), ["person"], threshold, strict=strict)
        red.redact_chunk("Herrn Mag. Karl Probstmüller")
        if ambiguous:
            red.redact_chunk("Lena Probstmüller")
        red.add_name_aliases()
        out = red.sweep_recurrences("Probstmüller / PROBSTMÜLLER")
        bare = red.entity_map["Probstmüller"]
        full = red.entity_map["Herrn Mag. Karl Probstmüller"]
        if out != f"{bare} / {bare}" or (bare == full) == ambiguous:
            failures.append("undetected surname: leaked or incorrectly merged")

    # Unit-level guards for filtering logic that GLiNER's synthetic-data
    # behavior is too unreliable to exercise end-to-end. Each entry:
    #     (label, surface, expected_rejected, why)
    reject_cases = [
        # Whole-surface role nouns are rejected (article-stripped).
        ("person", "Eigentümer", True, "bare role noun"),
        ("person", "Die Versicherungsnehmerin", True, "article + role noun"),
        # Multi-token role phrases: both tokens in ROLE_NOUNS.
        ("person", "Mieter und Vermieter", True, "multi-token: both role nouns"),
        ("person", "Käufer oder Verkäufer", True, "multi-token: both role nouns"),
        ("person", "der Antragsteller", True, "article + role noun"),
        # Codex P1: labeled-name spans must NOT be rejected: the proper-
        # noun tokens (Anna, Beispiel) survive the role-token check even
        # though "patient"/"kunde" matches ROLE_NOUNS.
        ("person", "Patient: Dr. Anna Beispiel", False,
         "label + name combo: name must survive"),
        ("person", "Kunde: Maria Muster", False,
         "label + name combo: name must survive"),
        # Real multi-token names pass cleanly.
        ("person", "Anna Beispiel", False, "regular name"),
        ("person", "Frau Schmidt", False, "title + surname"),
        # Vowel-free ID numbers must survive the OCR-garbage filter.
        ("bank account number", "12345678", False, "bare 8-digit account number"),
        ("passport number", "P1234567", False, "short passport number"),
        ("person", "Xkcdtrm", True, "vowel-free OCR garbage"),
        ("date of birth", "28.09.2026", True, "unanchored numeric date as DOB"),
    ]
    for label, surface, expect, why in reject_cases:
        got = reject_gliner_hit(label, surface)
        if got != expect:
            failures.append(
                f"reject_gliner_hit({label!r}, {surface!r}) = {got}, "
                f"expected {expect} ({why})"
            )

    # Unit cases for detect_language. The validation set covers the cases
    # that matter operationally: dominant-language detection for each
    # supported lang, the NL→fr false-positive that prompted the NL decoy,
    # and None for too-short / non-Latin inputs.
    detect_cases = [
        # (text, expected_lang, why)
        (
            "Die Bundesregierung hat ein neues Gesetz vorgelegt. Das Gesetz "
            "tritt im nächsten Jahr in Kraft. Die Opposition hat den Entwurf "
            "kritisiert und fordert weitere Anpassungen. Die Abstimmung wird "
            "voraussichtlich im Dezember stattfinden. Bürger und Unternehmen "
            "sollen entlastet werden, doch die Finanzierung ist noch unklar. "
            "Der Bundesrat muss ebenfalls zustimmen, bevor das Gesetz gilt.",
            "de", "German prose"
        ),
        (
            "The government announced a new framework for the regulation of "
            "artificial intelligence systems. The proposal would require "
            "companies to register their models with a central authority. "
            "Critics argue that the rules are too restrictive and may slow "
            "down innovation in the sector. Supporters say strong oversight "
            "is needed to protect consumers from potential harms.",
            "en", "English prose"
        ),
        (
            "De regering heeft dinsdag een nieuw wettelijk kader "
            "aangekondigd voor systemen die in kritieke infrastructuur "
            "worden gebruikt. Het voorstel verplicht bedrijven om hun "
            "modellen te registreren bij een centrale autoriteit en "
            "regelmatig audits te ondergaan. Volgens ambtenaren zijn de "
            "regels bedoeld om consumenten te beschermen en de openbare "
            "veiligheid te waarborgen. Critici stellen dat de eisen te "
            "streng zijn en innovatie kunnen vertragen. De minister van "
            "economische zaken zei dat de wet wordt aangepast als bedrijven "
            "met goede argumenten komen. Het parlement zal in december "
            "stemmen over het voorstel, en als het wordt aangenomen treedt "
            "het volgend jaar in werking. Burgers en bedrijven worden in de "
            "tussentijd uitgenodigd om hun mening te geven via een online "
            "consultatieproces dat tot eind oktober openstaat.",
            "nl", "Dutch decoy (must not be classified as fr/de/en)"
        ),
        ("Short text without enough tokens.", None, "too short"),
        ("政府は火曜日、新たな規制枠組みを発表した。", None, "non-Latin script"),
    ]
    for text, expect, why in detect_cases:
        got = detect_language(text)
        if got != expect:
            failures.append(
                f"detect_language({why}) = {got!r}, expected {expect!r}"
            )

    # Unit cases for trim_leading_role_prefix.
    trim_cases = [
        ("Patient: Dr. Anna Beispiel", "Dr. Anna Beispiel"),
        ("Kunde: Maria Muster", "Maria Muster"),
        # Codex follow-up P2: compact delimiters with/without spacing.
        ("Patient:Dr. Anna Beispiel", "Dr. Anna Beispiel"),     # no space after :
        ("Patient :Dr. Anna Beispiel", "Dr. Anna Beispiel"),    # space before :
        ("Kunde,Maria Muster", "Maria Muster"),                 # no space after ,
        # Normal name spans pass through unchanged.
        ("Anna Beispiel", "Anna Beispiel"),
        ("Dr. Anna Beispiel", "Dr. Anna Beispiel"),
        # Pure role phrases without a leading single-word role noun.
        ("Endnutzer oder Käufer", "Endnutzer oder Käufer"),
    ]
    for inp, expect in trim_cases:
        s, e = trim_leading_role_prefix(inp, 0, len(inp))
        got = inp[s:e]
        if got != expect:
            failures.append(
                f"trim_leading_role_prefix({inp!r}) = {got!r}, expected {expect!r}"
            )

    # Unit case for sweep_recurrences: short (4-5 digit) numeric IDs found
    # once must be replaced at later bare occurrences too.
    red = Redactor(model, labels_for(strict), threshold, strict=strict)
    red.entity_map["48213"] = "[account-1]"
    swept = red.sweep_recurrences("Konto 48213, Ref. 48213; 148213 bleibt.")
    if swept != "Konto [account-1], Ref. [account-1]; 148213 bleibt.":
        failures.append(f"sweep_recurrences short numeric ID: got {swept!r}")

    # Exercise header anchoring without NER: every name must be caught even
    # when the model misses it, including partially redacted and short names.
    for header in (
        "Name", "Vorname", "Nachname", "Familienname", "Versicherte Person",
        "Versicherte Personen", "Mitglied", "First name", "Last name",
        "Full name", "Given name", "Surname", "Nom", "Prénom", "Prenom",
        "Nom de famille", "Nombre", "Apellido", "Apellidos", "**NAME**:",
    ):
        red = Redactor(None, [], threshold)
        red.entity_map["Karl"] = "[person-1]"
        red.counters["person"] = 1
        table = (
            f"| {header} | Tarif | Rolle | Beginn |\n"
            "|---|---|---|---|\n"
            "| Anna Beispiel | Standard | Versicherungsnehmerin | 01.03.2025 |\n"
            "| [person-1] Beispiel | Premium | Eigentümer | 02.03.2025 |\n"
            "| Li | 200 | Kunde | 03.03.2025 |\n"
            "| Élodie O’Neill | 500 | Mieter | 04.03.2025 |\n"
            "| Karl | 300 | Zeuge | 05.03.2025 |\n"
            "| Versicherungsnehmer | 400 | Kunde | 06.03.2025 |\n"
            "| | 600 | Kunde | 07.03.2025 |"
        )
        out = red.redact_anchored_table_cells(table)
        for name in ("Anna", "Beispiel", "Li", "Élodie", "O’Neill", "Karl"):
            if name in out:
                failures.append(f"table header {header!r}: {name!r} survived")
        # Only column zero may change; headers, separators and adjacent
        # cells must stay byte-for-byte intact.
        before, after = table.splitlines(), out.splitlines()
        if (before[:2] != after[:2]
                or [r.split('|')[2:] for r in before[2:]]
                != [r.split('|')[2:] for r in after[2:]]
                or "| [person-1] " not in after[3]
                or "| [person-1] " not in after[6]
                or before[7:] != after[7:]
                or out != red.redact_anchored_table_cells(out)):
            failures.append(f"table header {header!r}: changed non-name content")
    for table in (
        "| Produktname | Tarif |\n|---|---|\n| Standard | Premium |",
        "| Name | Standard | Premium |",  # no column header separator
    ):
        red = Redactor(None, [], threshold)
        if red.redact_anchored_table_cells(table) != table:
            failures.append("table name anchoring: matched outside a name column")

    labels = labels_for(strict)
    for lang, case in SELFTEST_CASES.items():
        sample: str = case["input"]  # type: ignore[assignment]
        red = Redactor(model, labels, threshold, strict=strict)
        try:
            out = red.redact_chunk(sample)
            out = normalize_unicode(out)
            out = red.apply_pre_patterns_only(out)
            out = red.redact_anchored_table_cells(out)
            red.add_name_aliases()
            out = red.sweep_recurrences(out)
        except RedactionError as e:
            log("selftest", f"[{lang}] redaction failed: {e}",
                json_mode=json_mode, level="ERROR")
            raise typer.Exit(code=5)
        log("selftest", f"[{lang}] input:  {sample}", json_mode=json_mode)
        log("selftest", f"[{lang}] output: {out}", json_mode=json_mode)
        for needle in case["must_remove"]:  # type: ignore[union-attr]
            if needle in out:
                failures.append(f"{lang}: '{needle}' should be redacted but survived")
        for needle in case["must_keep"]:  # type: ignore[union-attr]
            if needle not in out:
                failures.append(f"{lang}: '{needle}' should be preserved but was redacted")
        for needle in case.get("known_leaks", []):  # type: ignore[union-attr]
            if needle in out:
                log("selftest", f"[{lang}] KNOWN LEAK: '{needle}' survived",
                    json_mode=json_mode, level="WARN")
            else:
                log("selftest", f"[{lang}] known leak '{needle}' did not "
                    "survive this run", json_mode=json_mode)
        # In default (non-strict) mode, also verify orgs/country/url/BIC/VAT
        # are PRESERVED (not redacted). Skip those checks in --strict.
        if not strict:
            for needle in case.get("default_must_keep", []):  # type: ignore[union-attr]
                if needle not in out:
                    failures.append(
                        f"{lang}: (default) '{needle}' should be preserved but was redacted"
                    )
        # In --strict mode, verify the things that are kept by default
        # ARE redacted with strict on.
        if strict:
            for needle in case.get("strict_must_remove", []):  # type: ignore[union-attr]
                if needle in out:
                    failures.append(
                        f"{lang}: (strict) '{needle}' should be redacted but survived"
                    )
    if failures:
        for f in failures:
            log("selftest", f, json_mode=json_mode, level="ERROR")
        raise typer.Exit(code=5)
    mode = "strict" if strict else "default"
    log("selftest", f"all checks passed ({mode} mode, {'+'.join(SELFTEST_CASES.keys())})",
        json_mode=json_mode)


# ── parallel processing ───────────────────────────────────────────────────

def _worker_init() -> None:
    """Worker bootstrap: load GLiNER once per process."""
    global _WORKER_MODEL
    from gliner import GLiNER  # noqa: PLW0603
    _WORKER_MODEL = GLiNER.from_pretrained(GLINER_MODEL, revision=GLINER_REVISION)


def _worker_process(args: tuple) -> Tuple[str, Optional[dict], Optional[str]]:
    """Run process_pdf in a worker. Returns (input_path, result_dict, error_msg)."""
    pdf_path, out_dir, rename, threshold, force, strict, ocr = args
    try:
        res = process_pdf(
            Path(pdf_path), Path(out_dir), _WORKER_MODEL,
            rename=rename, threshold=threshold,
            json_mode=False, force=force, strict=strict, ocr=ocr,
        )
        return (str(pdf_path), res, None)
    except RedactionError as e:
        return (str(pdf_path), None, f"redaction: {e}")
    except Exception as e:
        return (str(pdf_path), None, f"conversion: {e}")


def _run_parallel(
    inputs: List[Path], out_dir: Path, *, rename: str, threshold: float,
    force: bool, strict: bool, ocr: bool, json_mode: bool, jobs: int,
) -> Tuple[List[dict], int]:
    import concurrent.futures as cf
    args_list = [
        (str(p), str(out_dir), rename, threshold, force, strict, ocr)
        for p in inputs
    ]
    results: List[dict] = []
    failed = 0
    with cf.ProcessPoolExecutor(max_workers=jobs, initializer=_worker_init) as ex:
        for pdf_path, res, err in ex.map(_worker_process, args_list):
            name = Path(pdf_path).name
            if err is not None:
                log("redaction" if err.startswith("redaction") else "conversion",
                    f"failed on {name}: {err}. Output NOT written.",
                    json_mode=json_mode, level="ERROR")
                failed += 1
                continue
            assert res is not None
            results.append(res)
            if json_mode:
                print(json.dumps(res, ensure_ascii=False))
            else:
                log("output",
                    f"{res['output']} ({res['n_entities']} entities, "
                    f"{res['n_text_items']} text, {res['n_tables']} tables)")
    return results, failed


# ── CLI ───────────────────────────────────────────────────────────────────

app = typer.Typer(add_completion=False, help=__doc__, no_args_is_help=True)


@app.command()
def main(
    inputs: List[Path] = typer.Argument(None, help="PDF file(s) to redact."),
    out_dir: Optional[Path] = typer.Option(
        None, "--out-dir", "-o",
        help="Directory for redacted .md output. Default: each PDF's parent "
             "directory (in-place: contract.pdf → contract.md alongside)."
    ),
    rename: str = typer.Option(
        "keep", "--rename",
        help="Output naming: keep|auto|ask|hash|<explicit-name>."
    ),
    threshold: float = typer.Option(
        DEFAULT_THRESHOLD, "--threshold", help="GLiNER score threshold."
    ),
    force: bool = typer.Option(
        False, "--force", help="Overwrite existing outputs."
    ),
    strict: bool = typer.Option(
        False, "--strict",
        help="Also redact organization/company names, country, URLs, BIC, VAT "
             "IDs. Default keeps these visible (useful when comparing offers "
             "from named companies). Personal PII is always redacted."
    ),
    ocr: bool = typer.Option(
        False, "--ocr",
        help="Run OCR on images inside PDFs. Default off (text PDFs only). "
             "Enable for scanned PDFs without a text layer. Slow."
    ),
    jobs: int = typer.Option(
        1, "--jobs", "-j",
        help="Process N PDFs in parallel worker processes. Each worker loads "
             "GLiNER independently (~250MB RAM each); useful for batches of "
             "≥4 files. Default 1 (serial)."
    ),
    json_mode: bool = typer.Option(
        False, "--json", help="Emit JSON result line per file on stdout."
    ),
    verbose: bool = typer.Option(
        False, "--verbose", "-v", help="Show INFO-level library logs."
    ),
    selftest: bool = typer.Option(
        False, "--selftest", help="Run a built-in correctness check and exit."
    ),
):
    if verbose:
        logging.getLogger().setLevel(logging.INFO)

    log("init", f"loading GLiNER ({GLINER_MODEL})…", json_mode=json_mode)
    from gliner import GLiNER
    model = GLiNER.from_pretrained(GLINER_MODEL, revision=GLINER_REVISION)

    if selftest:
        run_selftest(model, threshold, json_mode=json_mode, strict=strict)
        raise typer.Exit(code=0)

    if not inputs:
        log("input", "no input PDFs given. Pass paths as arguments.",
            json_mode=json_mode, level="ERROR")
        raise typer.Exit(code=4)

    valid_inputs: List[Path] = []
    failed = 0
    for pdf in inputs:
        if not pdf.exists():
            log("input", f"not found: {pdf}", json_mode=json_mode, level="ERROR")
            failed += 1
        else:
            valid_inputs.append(pdf)

    # Resolve out_dir per PDF if --out-dir not given; otherwise share one dir.
    def _out_dir_for(pdf: Path) -> Path:
        return out_dir if out_dir is not None else pdf.parent

    # Cloud-sync warning: check each unique resolved out_dir once.
    for d in {_out_dir_for(p).resolve() for p in valid_inputs}:
        d.mkdir(parents=True, exist_ok=True)
        warn_if_cloud_synced(d, json_mode=json_mode)

    use_parallel = jobs > 1 and len(valid_inputs) > 1
    results: List[dict] = []
    if use_parallel:
        log("init", f"parallel mode: {jobs} workers across {len(valid_inputs)} files",
            json_mode=json_mode)
        # Group by resolved out_dir so each batch shares one path arg.
        groups: Dict[str, List[Path]] = {}
        for p in valid_inputs:
            groups.setdefault(str(_out_dir_for(p).resolve()), []).append(p)
        for d_str, files in groups.items():
            sub, n_fail = _run_parallel(
                files, Path(d_str),
                rename=rename, threshold=threshold,
                force=force, strict=strict, ocr=ocr,
                json_mode=json_mode, jobs=jobs,
            )
            results.extend(sub)
            failed += n_fail
    else:
        for pdf in valid_inputs:
            try:
                res = process_pdf(
                    pdf, _out_dir_for(pdf), model,
                    rename=rename, threshold=threshold,
                    json_mode=json_mode, force=force, strict=strict, ocr=ocr,
                )
                results.append(res)
                if json_mode:
                    print(json.dumps(res, ensure_ascii=False))
                else:
                    log("output",
                        f"{res['output']} ({res['n_entities']} entities, "
                        f"{res['n_text_items']} text, {res['n_tables']} tables)")
            except RedactionError as e:
                log("redaction", f"failed on {pdf.name}: {e} "
                    "Output NOT written (fail-closed).",
                    json_mode=json_mode, level="ERROR")
                failed += 1
            except Exception as e:
                log("conversion", f"failed on {pdf.name}: {e}. "
                    "NEXT: verify the file opens in a PDF viewer; if scanned, "
                    "consider running with --ocr or running ocrmypdf first.",
                    json_mode=json_mode, level="ERROR")
                failed += 1

    ok = len(results)
    total = ok + failed
    out_summary = (
        f"output: {out_dir}" if out_dir is not None
        else "output: alongside each input PDF"
    )
    log("summary", f"{ok}/{total} ok | "
        f"{sum(r['n_entities'] for r in results)} entities total | "
        f"{out_summary}")

    if failed:
        raise typer.Exit(code=3)


if __name__ == "__main__":
    app()
